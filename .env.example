# ==============================================================================
# Fretboard — Environment Configuration
# Copy this file to .env (or .env.local) and fill in your credentials.
# Never commit .env, .env.local, or private keys (*.p8 / *.pem) to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL (Prisma)
# Local example: postgresql://postgres:postgres@localhost:5432/fretboard?schema=public
# Hosted example (Neon/Supabase/RDS): postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ------------------------------------------------------------------------------
# 2. Auth.js v5 Core Secret & Application URL
# Generate AUTH_SECRET with: npx auth secret   (or: openssl rand -base64 32)
# ------------------------------------------------------------------------------
AUTH_SECRET=""

# Base URL of the application (use your deployed HTTPS domain in production)
AUTH_URL="http://localhost:3000"

# Legacy NextAuth URL compatibility (keep identical to AUTH_URL; do not conflict)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Google OAuth
# Configure in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized JavaScript origins: http://localhost:3000 (and production origin)
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
# ------------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

